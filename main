#!/bin/bash

#SBATCH --job-name=app
#SBATCH --ntasks-per-node=1
#SBATCH --mem=4G
#SBATCH --time=01:00:00

# brainlife.io's orchestrator invokes this directly (`./main`), after staging
# config.json into the working directory.

set -e

mkdir -p t1_brain

export SINGULARITYENV_LC_ALL=C.UTF-8
export SINGULARITYENV_LANG=C.UTF-8

singularity exec -e docker://brainlife/fsl:5.0.11 ./run_bet.sh

[ -f t1_brain/t1.nii.gz ] || { echo "no output produced"; exit 1; }
exit 0
